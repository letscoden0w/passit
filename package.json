{
  "name": "passit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PassIt — study reviewers, mock exams and exam packs as printable PDFs. An x402 pay-per-call Agent Service Provider on OKX.AI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "compliance": "tsx scripts/compliance-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pdfkit": "^0.15.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
