# ─── PassIt configuration ────────────────────────────────────────────
# Copy to `.env` and fill in. Everything has a safe default, so the server
# boots with zero configuration (mock payments + offline content engine).

# ─── Server ──────────────────────────────────────────────────────────
PORT=8402
# Public HTTPS base URL. REQUIRED before registering with OKX — it goes
# into the x402 challenge `resource.url`, and OKX validates it.
PUBLIC_URL=https://passit.onrender.com

# ─── Payments (OKX x402) ─────────────────────────────────────────────
# mock  | live | disabled
#   mock     -> accepts a test token, no chain. Local dev + tests.
#   live     -> real x402 via the OKX Payment SDK middleware.
#   disabled -> free endpoints (no billing). Also a valid ASP form.
PAYMENT_MODE=mock

# Network: xlayer (mainnet, eip155:196) | xlayer-testnet (eip155:1952)
# Test the full loop on testnet first, then flip this one value.
X402_NETWORK=xlayer

# Your receiving wallet (EVM address). Use your OKX Agentic Wallet address.
PAY_TO_ADDRESS=

# OKX Developer Portal credentials — https://web3.okx.com/onchainos/dev-portal
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Wait for on-chain confirmation before delivering the file.
# true = safest (we only hand over the PDF once payment is confirmed).
OKX_SYNC_SETTLE=true

# Optional: override the settlement token per network. Defaults are baked
# in (X Layer mainnet USDT0). Set this for testnet, whose USDT0 address
# differs — claim test funds at https://www.okx.com/xlayer/faucet/xlayerfaucet
X402_ASSET=
X402_ASSET_DECIMALS=

# ─── Content engine (free LLM providers) ─────────────────────────────
# Comma-separated priority order. First healthy provider wins; on
# rate-limit/failure the next takes over. Any subset works — configure
# one or all. With none set, PassIt falls back to the built-in scaffold.
LLM_PROVIDERS=groq,mistral,gemini,cerebras

# Groq — https://console.groq.com/keys (no card)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral — https://console.mistral.ai (no card, 1B tokens/month)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Google Gemini — https://aistudio.google.com/apikey (no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cerebras — https://cloud.cerebras.ai (no card)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Minutes a provider stays benched after a rate-limit/error before retry.
PROVIDER_COOLDOWN_MINUTES=5

# ─── Cache ───────────────────────────────────────────────────────────
# In-memory cache of generated content, keyed by service+topic+language.
# Repeated topics (Photosynthesis, Newton's Laws...) are served instantly
# with zero LLM calls.
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500
CACHE_TTL_MINUTES=1440
